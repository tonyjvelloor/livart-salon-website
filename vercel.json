{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.livartsalon.com"
        }
      ],
      "destination": "https://livartsalon.com/:path*",
      "permanent": true
    },
    {
      "source": "/hair-works/:path*",
      "destination": "/hair-styling/",
      "permanent": true
    },
    {
      "source": "/hair-works",
      "destination": "/hair-styling/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "m"
        }
      ],
      "destination": "/api/gone"
    },
    {
      "source": "/(.*\\.php.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/(kto-vladelec.*|kosmolot.*|oprovergaem-mify.*|chto-osobennogo.*|aapaa.*|lp_business_gift.*)",
      "destination": "/api/gone"
    }
  ],
  "headers": [
    {
      "source": "/api/gone",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
